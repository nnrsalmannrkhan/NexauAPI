# Environment Configuration
# Copy this file to .env and fill in your values
# On Render, set these as Environment Variables in the Render Dashboard

# Server Environment
NODE_ENV=development
PORT=5000

# JWT Configuration (REQUIRED for production)
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Render: Set JWT_SECRET in Environment → Environment Variables
JWT_SECRET=your_super_secret_jwt_key_change_in_production_1234567890
JWT_EXPIRES_IN=7d

# Database Configuration
# On Render: Use /tmp/ for writable storage (filesystem is ephemeral)
# DB_PATH=./database.sqlite
DB_PATH=./database.sqlite

# CORS Configuration (comma-separated list of allowed origins)
# On Render: Set to your app URL, e.g., https://your-app-name.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app-name.onrender.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
